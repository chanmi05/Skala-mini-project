# Copy only needed settings into voice-ai_code/.env. Never commit real secrets.
OPENAI_API_KEY=replace-me
JWT_SECRET=use-the-same-secret-as-Java
# mock: fixed response / demo: local fictional-rule retrieval / live: team RAG.
# Without an explicit setting, the code defaults to live.
VOICE_RAG_MODE=demo
RAG_BASE_URL=http://localhost:8001
WHISPER_MODEL=small
WHISPER_LANGUAGE=ko
VOICE_CORRECTION_ENABLED=true
VOICE_CORRECTION_MODEL=gpt-4o-mini
# HR vocabulary hint is enabled by default. Set an empty value to disable it.
# This is a recognition hint, not a guaranteed transcript or replacement rule.
# WHISPER_INITIAL_PROMPT=연차, 근태, 경조휴가, 육아휴직
