*.log
*.pid
*.sqlite
*.sqlite3
*.sqlite3-journal
*.swp
*.swo
*~
Thumbs.db

# FAISS indexes are intentionally retained for team sharing.
# Agree with the RAG owner before excluding rag-code-template_ext/faiss_db/.

